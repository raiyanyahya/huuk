{
  // Example huuk rules file. Copy to <project>/.claude/huuk.rules.json
  // (project scope) or ~/.claude/huuk.rules.json (global scope).
  // Comments are allowed. Project rules override global rules with the same id.
  "rules": [
    {
      "id": "gate-push",
      "description": "Tests and lint must pass before any git push",
      "on": "bash:git push*",
      "severity": "block",
      "do": [
        { "run": "pytest -q" },
        { "run": "ruff check ." }
      ]
    },
    {
      "id": "no-force-push-protected",
      "description": "Never force-push to main/master",
      "on": "bash:git push*--force*",
      "if": { "branch": ["main", "master"] },
      "do": [
        { "forbid": "Force-pushing to a protected branch is not allowed." }
      ]
    },
    {
      "id": "protect-env",
      "description": "Env files are managed by hand, not by the agent",
      "on": "edit:.env*",
      "do": [
        { "steer": "Do not modify env files directly. Tell the user which variable to add or change, and let them edit the file themselves." }
      ]
    },
    {
      "id": "init-branch-name",
      "description": "Ask which default branch name to use before git init",
      // No "*", so this matches the bare `git init` only — the retried
      // `git init -b <name>` sails through instead of looping.
      "on": "bash:git init",
      "do": [
        { "steer": "Before running git init, ask the user what the default branch should be named, then run `git init -b <name>`." }
      ]
    },
    {
      "id": "format-python",
      "description": "Auto-format Python files after edits",
      "on": "edited:*.py",
      "severity": "warn",
      "do": [
        { "run": "black {file}" }
      ]
    },
    {
      "id": "audit-after-install",
      "description": "Surface vulnerabilities right after installing packages",
      "on": "ran:npm install*",
      "severity": "warn",
      "do": [
        { "run": "npm audit --audit-level=high" }
      ]
    },
    {
      "id": "env-briefing",
      "description": "Show repo status at session start",
      "on": "session_start",
      "do": [
        { "run": "git status --short --branch" },
        { "run": "git log --oneline -5" }
      ]
    },
    {
      "id": "deploy-needs-healthy-staging",
      "description": "Staging API must answer before deploying",
      "on": "bash:npm run deploy*",
      "do": [
        { "run": "curl -fsS --max-time 10 https://staging.example.com/health" }
      ]
    },
    {
      "id": "slack-push-report",
      "description": "Report every push to the team channel (needs $SLACK_WEBHOOK)",
      "on": "ran:git push*",
      "severity": "warn",
      "do": [
        { "run": "curl -sS -X POST -H 'Content-type: application/json' --data \"{\\\"text\\\": \\\"huuk: pushed $(git log -1 --oneline)\\\"}\" \"$SLACK_WEBHOOK\"" }
      ]
    },
    {
      "id": "typecheck-on-stop",
      "description": "Code must typecheck before Claude finishes a turn",
      "on": "stop",
      "if": { "exists": "tsconfig.json" },
      "do": [
        { "run": "npx tsc --noEmit" }
      ]
    },
    {
      "id": "lockfile-hands-off",
      "description": "Lockfiles are generated, not edited",
      "on": "edit:package-lock.json",
      "do": [
        { "steer": "Never edit the lockfile by hand — run the package manager instead." }
      ]
    },
    {
      // Flip "enabled" on if your team works on feature branches.
      "id": "no-direct-main",
      "description": "Work happens on branches, not on main",
      "on": "bash:git push*",
      "if": { "branch": ["main", "master"] },
      "enabled": false,
      "do": [
        { "steer": "Direct pushes to main are not allowed. Create a feature branch, push it, and offer to open a PR." }
      ]
    }
  ]
}
